# Copie este arquivo para .env (mesma pasta) e preencha os valores reais.
# Nenhuma dessas chaves é enviada pra lugar nenhum além do provedor
# correspondente (Groq/Google/Telegram) — 100% local fora dessas chamadas.

# Cascata de modelos — 1º e 2º andar (cerebro_maestro.py). Obrigatórias pro
# chat funcionar com a cascata cloud (Groq -> Gemini -> Claude -> local).
GROQ_API_KEY=
GEMINI_API_KEY=

# Bot Telegram bidirecional (lyra_telegram.py) — opcional, só necessário se
# for usar a Lyra pelo Telegram. Obtenha com @BotFather -> /newbot.
TELEGRAM_BOT_TOKEN=

# IDs de usuários Telegram permitidos a falar com o bot, separados por
# vírgula. Vazio = qualquer usuário pode falar com o bot (não recomendado
# se o token vazar).
TELEGRAM_ALLOWED_USERS=

# SurrealDB (config.py) — default root/root é só pra dev local, 127.0.0.1.
# Trocar por credencial de verdade se algum dia expuser a rede.
SURREAL_USER=root
SURREAL_PASS=root
